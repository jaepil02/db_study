<!-- 사용자 프로파일 수준 설정 — 정본 docs/05_data_stores/03_clickhouse_schema.md §서버 설정 계약 -->
<clickhouse>
    <profiles>
        <default>
            <!-- 적재는 단일 flusher 배치(ADR-09) · C안 비교 실험에서만 켠다 -->
            <async_insert>0</async_insert>
            <max_insert_block_size>1048576</max_insert_block_size>
            <!-- MV 실패를 삽입 오류로 드러낸다(REQ-ING-16) -->
            <materialized_views_ignore_errors>0</materialized_views_ignore_errors>
            <!-- 같은 토큰 재시도가 롤업을 이중 계수하지 않게 종속 MV도 중복 제거한다(ADR-14 보강 · EXP-32 기록 001).
                 롤업 3테이블의 non_replicated_deduplication_window와 한 쌍이다 — 둘 중 하나만 있어도 재시도가 롤업을 두 배로 센다(실측).
                 async_insert 1과 함께면 서버가 삽입을 Code 344로 거부한다(실측) — C안 비교 실험은 async_insert 1 · 이 값 0으로 함께 바꾼다 -->
            <deduplicate_blocks_in_dependent_materialized_views>1</deduplicate_blocks_in_dependent_materialized_views>
        </default>
    </profiles>
</clickhouse>
