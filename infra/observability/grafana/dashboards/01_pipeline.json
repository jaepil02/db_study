    {
      "type": "timeseries",
      "title": "컨슈머 랙 — lag · pending 겹침 · 합은 선",
      "description": "판독 규칙 — lag와 pending을 겹쳐 그리고 합(consumer_lag)은 선으로 본다. lag가 오르면 소비 병목, pending이 오르면 삽입 병목이다. 합 하나로 보면 컨슈머 증설과 배치 확대 중 무엇이 필요한지 가를 수 없다(ADR-09 뒤 증설은 삽입 병목에 무효). consumer_lag = 그룹 lag + pending(01_metrics_catalog §컨슈머 랙 판정) · 부하 중 pending은 in-flight 2배치 분량 안에서 유계가 정상(AC-19).",
      "datasource": {
        "type": "prometheus",
        "uid": "db-study-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "db-study-prometheus"
          },
          "refId": "A",
          "expr": "ing_group_lag",
          "legendFormat": "lag(미배달)",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "db-study-prometheus"
          },
          "refId": "B",
          "expr": "ing_group_pending",
          "legendFormat": "pending(미확인)",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "db-study-prometheus"
          },
          "refId": "C",
          "expr": "consumer_lag",
          "legendFormat": "합 consumer_lag",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "db-study-prometheus"
          },
          "refId": "D",
          "expr": "ing_consumer_lag_unknown",
          "legendFormat": "산출 불가(1)",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "lag.*|pending.*"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 30
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "합 consumer_lag"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "산출 불가.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              },
              {
                "id": "max",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
